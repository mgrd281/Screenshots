/* What Siri listens for to run Cover the Latest Screenshot (Intents.swift):
   each phrase as the code writes it, with the app's name as its
   placeholder, which every phrase and translation holds once. */

"Cover my latest screenshot with ${applicationName}" = "${applicationName} ile en yeni ekran görüntümü gizle";
"${applicationName}, cover my screenshot" = "${applicationName}, ekran görüntümü gizle";
