{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY:-}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "sh",
      "args": [
        ".claude/mcp/playwright-mcp.sh"
      ]
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "shadcn": {
      "type": "stdio",
      "command": "sh",
      "args": [
        ".claude/mcp/shadcn-mcp.sh"
      ]
    },
    "lottie-creator": {
      "type": "stdio",
      "command": "sh",
      "args": [
        ".claude/mcp/lottie-creator-mcp.sh"
      ]
    },
    "creatomate": {
      "type": "http",
      "url": "https://api.creatomate.com/mcp"
    }
  }
}
