"Hang" = "Colgar";
"Photos and PDFs hang on the line, ready to send with their private details covered." = "Las fotos y los PDF se cuelgan en la cuerda, listos para enviar con sus datos privados ocultos.";
"Drop here – private details get covered" = "Suelta aquí: los datos privados se ocultan";
"Drop here to hang it" = "Suelta aquí para colgarlo";
"Only photos and PDFs can hang on the line." = "Solo se pueden colgar fotos y PDF en la cuerda.";
"This PDF is locked with a password." = "Este PDF está protegido con contraseña.";
"This PDF is too long: up to %d pages." = "Este PDF es demasiado largo: hasta %d páginas.";
"Still covering the private details…" = "Todavía se están ocultando los datos privados…";
"Could not cover the private details in this PDF." = "No se pudieron ocultar los datos privados de este PDF.";
"Page %d of %d" = "Página %d de %d";
"Previous Page" = "Página anterior";
"Next Page" = "Página siguiente";

/* Hide private details in a copy, beside a photo or PDF from Finder */
"Hide in this copy" = "Ocultar en esta copia";
"The copy has no place or camera details. The original stays as it is." = "La copia no tiene datos de lugar ni de cámara. El original no cambia.";
"Save Copy…" = "Guardar copia…";
"%@ (covered)" = "%@ (cubierto)";
"Saved beside the original as %@." = "Guardada junto al original como %@.";
"Could not save the copy." = "No se pudo guardar la copia.";
"Choose one photo or PDF at a time." = "Elige una foto o un PDF a la vez.";

