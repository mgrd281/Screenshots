"Press %@ or click the screenshot button at the edge of the screen, then drag over an area, click a window, or press Return for the whole screen. It hangs on the line at once, with nothing to set up." = "%@ tuşlarına bas ya da ekranın kenarındaki ekran görüntüsü düğmesini tıkla, sonra bir alanın üzerinde sürükle, bir pencereyi tıkla ya da tüm ekran için Return’e bas. Hemen ipe asılır, hiçbir şey ayarlamadan.";
"Try It Now" = "Şimdi dene";
"Use the Screenshot App…" = "Ekran Görüntüsü’nü kullan…";
"Press %@ or click the screenshot button. Nothing to set up." = "%@ tuşlarına bas ya da ekran görüntüsü düğmesini tıkla. Ayarlanacak bir şey yok.";
"Also from the Screenshot app" = "Ekran Görüntüsü’nden de";

/* Message with the photos */
"Add a message…" = "Mesaj ekle…";
"Saved messages" = "Kayıtlı mesajlar";
"Add Message" = "Mesaj ekle";
"Here is the invoice for your order {order}." = "{order} numaralı siparişinin faturası burada.";
"They wait above the message bar. {order}, {total}, {date}, {name} and {tracking} fill in from the photo; one of a kind you cover stays empty." = "Mesaj çubuğunun üstünde bekler. {order}, {total}, {date}, {name} ve {tracking} fotoğraftan doldurulur; gizlediğin bir türden olan boş kalır.";
"Send with a Message…" = "Mesajla gönder…";

