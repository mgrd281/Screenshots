"The time comes from the PTB’s atomic clock in Germany, over the internet. Only the question for the time goes out; without a connection, the Mac’s clock is used." = "Saat, internet üzerinden Almanya’daki PTB’nin atom saatinden gelir. Dışarı yalnızca saat sorusu çıkar; bağlantı yoksa Mac’in saati kullanılır.";
"Atomic time from the PTB, Germany" = "PTB atom saati, Almanya";
"Time from the Mac’s clock" = "Mac’in saatinden zaman";
"Page: %@" = "Sayfa: %@";
"Fingerprint (SHA-256): %@" = "Parmak izi (SHA-256): %@";
"%@ with time stamp" = "%@ zaman damgalı";

/* Whole page */
"Capture Whole Page" = "Tüm sayfayı yakala";
"Capture a whole page" = "Tüm bir sayfayı yakala";
