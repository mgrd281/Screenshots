"Move Earlier" = "Öne taşı";
"Move Later" = "Arkaya taşı";

/* Time stamp */
"Time stamp" = "Zaman damgası";
"Stamp the date and time" = "Tarih ve saati damgala";
"At the top, on the line and in a copy next to the screenshot" = "Üstte, ipte ve ekran görüntüsünün yanındaki bir kopyada";
