"Press %@ or click the screenshot button at the edge of the screen, then drag over an area, click a window, or press Return for the whole screen. It hangs on the line at once, with nothing to set up." = "اضغط %@ أو انقر زر التصوير على حافة الشاشة، ثم اسحب فوق منطقة، أو انقر على نافذة، أو اضغط Return للشاشة كلها. تعلق الصورة على الحبل فورًا، بلا أي إعداد.";
"Try It Now" = "جرّبه الآن";
"Use the Screenshot App…" = "استخدام «لقطة شاشة»…";
"Press %@ or click the screenshot button. Nothing to set up." = "اضغط %@ أو انقر زر التصوير. لا شيء لإعداده.";
"Also from the Screenshot app" = "ومن تطبيق «لقطة شاشة» أيضًا";

/* Message with the photos */
"Add a message…" = "أضف رسالة…";
"Send with a Message…" = "إرسال مع رسالة…";

/* Order on the line */
"Move Earlier" = "نقل إلى الأمام";
"Move Later" = "نقل إلى الخلف";

/* Time stamp */
"Time stamp" = "ختم الوقت";
"Stamp the date and time" = "اختم التاريخ والوقت";
"At the top, on the line and in a copy next to the screenshot" = "في الأعلى، على الحبل وفي نسخة بجانب اللقطة";
"Which screenshots" = "أي اللقطات";
"Screenshots of the whole screen" = "لقطات الشاشة كلها";
"Every screenshot" = "كل لقطة";
"Words before the date" = "كلمات قبل التاريخ";
"Optional, like your shop’s name" = "اختياري، مثل اسم متجرك";
"The screenshot itself stays as it was; the stamped copy is saved next to it." = "اللقطة نفسها تبقى كما هي، والنسخة المختومة تُحفظ بجانبها.";
"The time comes from the PTB’s atomic clock in Germany, over the internet. Only the question for the time goes out; without a connection, the Mac’s clock is used." = "يأتي الوقت عبر الإنترنت من الساعة الذرية لمعهد PTB في ألمانيا. لا يخرج إلا سؤال عن الوقت، ودون اتصال تُستعمل ساعة الـMac.";
"Atomic time from the PTB, Germany" = "الوقت الذري من PTB، ألمانيا";
"Time from the Mac’s clock" = "الوقت من ساعة الـMac";
"Page: %@" = "الصفحة: %@";
"Fingerprint (SHA-256): %@" = "البصمة (SHA-256): %@";
"%@ with time stamp" = "%@ مع ختم الوقت";

/* Whole page */
"Capture Whole Page" = "تصوير الصفحة كاملة";
"Capture a whole page" = "تصوير صفحة كاملة";
"Capturing the whole page…" = "يجري تصوير الصفحة كاملة…";
"Open the page to capture first, then try again." = "افتح الصفحة التي تريد تصويرها أولًا، ثم حاول مرة أخرى.";
"The page could not be captured." = "تعذّر تصوير الصفحة.";
"To scroll the page, Snapfly needs to press keys for you. Allow it in System Settings, then try again." = "كي يمرّر Snapfly الصفحة، يحتاج إلى أن يضغط المفاتيح نيابةً عنك. اسمح له بذلك في إعدادات النظام، ثم حاول مرة أخرى.";

/* iPhone */
"Cover Private Details" = "تغطية المعلومات الخاصة";
"No screenshots yet" = "لا توجد لقطات شاشة بعد";
"Take a screenshot, then come back here." = "التقط لقطة شاشة، ثم عُد إلى هنا.";
"Allow Snapfly to see your screenshots" = "اسمح لـ Snapfly برؤية لقطات شاشتك";
"Snapfly covers names, addresses and other private details in your screenshots, right on this iPhone. Nothing is sent anywhere." = "يغطي Snapfly الأسماء والعناوين وغيرها من المعلومات الخاصة في لقطات شاشتك، على هذا الآيفون نفسه. لا يُرسل شيء إلى أي مكان.";
"Allow Access" = "السماح بالوصول";
"Snapfly may not see your screenshots. Allow it in Settings › Privacy & Security › Photos." = "لا يُسمح لـ Snapfly برؤية لقطات شاشتك. اسمح له من الإعدادات › الخصوصية والأمن › الصور.";
"Covering private details…" = "تُغطّى المعلومات الخاصة…";
"The picture could not be read." = "تعذّرت قراءة الصورة.";
"Nothing private found" = "لم يُعثر على شيء خاص";
"Details covered: %d" = "المعلومات المغطاة: %d";
"Saved to Photos" = "حُفظت في الصور";
"The picture could not be saved." = "تعذّر حفظ الصورة.";
"Save" = "حفظ";
"What to cover" = "ما يُغطّى";
"Take a screenshot as usual." = "التقط لقطة شاشة كالمعتاد.";
"Double tap the back of your iPhone: the latest screenshot is covered and copied, ready to paste into a chat." = "انقر مرتين على ظهر الآيفون: تُغطّى أحدث لقطة شاشة وتُنسخ، جاهزة للّصق في الدردشة.";
"To set it up once, open Settings › Accessibility › Touch › Back Tap › Double Tap, and choose %@." = "لضبط ذلك مرة واحدة، افتح الإعدادات › تسهيلات الاستخدام › اللمس › النقر على الظهر › نقر مزدوج، واختر %@.";
"Cover the Latest Screenshot" = "تغطية أحدث لقطة شاشة";
"Double tap the back of your iPhone" = "انقر مرتين على ظهر الآيفون";
"Everything happens on this iPhone. Nothing is sent anywhere." = "كل شيء يحدث على هذا الآيفون. لا يُرسل شيء إلى أي مكان.";
"Snapfly may not see your screenshots yet. Open Snapfly once and allow it." = "لا يُسمح لـ Snapfly برؤية لقطات شاشتك بعد. افتح Snapfly مرة واحدة واسمح له.";
"There is no screenshot yet." = "لا توجد لقطة شاشة بعد.";
"Covered and copied, ready to paste." = "غُطّيت ونُسخت، جاهزة للّصق.";

/* Photos and PDFs from anywhere on the Mac */
"Add Files…" = "إضافة ملفات…";
"Hang" = "تعليق";
"Photos and PDFs hang on the line, ready to send with their private details covered." = "تُعلَّق الصور وملفات PDF على الحبل، جاهزة للإرسال ومعلوماتها الخاصة مغطّاة.";
"Drop here – private details get covered" = "أفلِت هنا، وستُغطّى المعلومات الخاصة";
"Drop here to hang it" = "أفلِت هنا لتعليقه";
"Only photos and PDFs can hang on the line." = "يمكن تعليق الصور وملفات PDF فقط على الحبل.";
"This PDF is locked with a password." = "ملف PDF هذا مقفل بكلمة سر.";
"This PDF is too long: up to %d pages." = "ملف PDF هذا طويل جدًا: الحد %d صفحة.";
"Still covering the private details…" = "ما زالت المعلومات الخاصة تُغطّى…";
"Could not cover the private details in this PDF." = "تعذّرت تغطية المعلومات الخاصة في ملف PDF هذا.";
"Page %d of %d" = "الصفحة %d من %d";
"Previous Page" = "الصفحة السابقة";
"Next Page" = "الصفحة التالية";

/* Hide private details in a copy, beside a photo or PDF from Finder */
"Hide in this copy" = "إخفاؤه في هذه النسخة";
"The copy has no place or camera details. The original stays as it is." = "النسخة لا تحمل مكان التقاط الصورة ولا بيانات الكاميرا. الأصل يبقى كما هو.";
"Save Copy…" = "حفظ النسخة…";
"%@ (covered)" = "%@ (مغطّى)";
"Saved beside the original as %@." = "حُفظت بجانب الأصل باسم %@.";
"Could not save the copy." = "تعذّر حفظ النسخة.";
"Choose one photo or PDF at a time." = "اختر صورة واحدة أو ملف PDF واحدًا في كل مرة.";
